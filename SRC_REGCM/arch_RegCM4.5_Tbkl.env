#!/bin/bash
# ---------------------------------------------------------------------------
# Author: M. El Aabaribaoune (@um6p)
# Description:
# This script sets up the environment needed to install RegCM on the 
# Toubkal supercomputer by loading the required modules.
# ---------------------------------------------------------------------------

# Purge any existing modules
module purge

# Load required modules
module load GCC/11.2.0
module load OpenMPI/4.1.1-GCC-11.2.0
module load netCDF/4.8.1-gompi-2021b
module load HDF5/1.12.1-gompi-2021b
module load netCDF-Fortran/4.5.3-gompi-2021b
module load libtool/2.4.6-GCCcore-11.2.0

# List loaded modules
echo "=== Loaded Modules ==="
module list

# Print success message
echo "Environment set up for RegCM installation on Toubkal supercomputer."

