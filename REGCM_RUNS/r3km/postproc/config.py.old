# ─── Helpers ─────────────────────────────────────────────────────────────────
def sts_files(year=None):
    """Return sorted list of STS daily files for a given year (or all years)."""
    pattern = f"test_001_STS.{year}*.nc" if year else "test_001_STS.*.nc"
    return sorted(OUTPUT_DIR.glob(pattern))


def srf_files(year=None):
    """Return sorted list of SRF 6-hourly files for a given year."""
    pattern = f"test_001_SRF.{year}*.nc" if year else "test_001_SRF.*.nc"
    return sorted(OUTPUT_DIR.glob(pattern))
